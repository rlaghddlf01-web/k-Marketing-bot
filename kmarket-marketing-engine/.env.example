# 🤖 AI & LLM Settings
GEMINI_API_KEY=your_gemini_api_key_here

# ⚡ Supabase Cloud Database (Self-Learning & Central Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# 📲 Telegram Bot (Daily Reports & SOS Emergency Alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 🤖 Reddit API (Lead Hunter & Auto-Responder)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=UniversalExpatGrowthBot/1.0
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# 🌐 Target Service Base URLs
KMARKET_BASE_URL=https://k-market.app
EASYTAX_BASE_URL=https://easy-tax.app
KTELECOM_BASE_URL=https://k-telecom.app
LOAN_BASE_URL=https://expat-loan.app
HOUSING_BASE_URL=https://expat-housing.app
REMIT_BASE_URL=https://global-remit.app

# ⚙️ Autopilot & Anti-Ban Safety Settings
AUTOPILOT_MODE=1
REDDIT_AUTO_REPLY=1
REPLY_DELAY_MIN_SEC=180
REPLY_DELAY_MAX_SEC=420
DAILY_REDDIT_LIMIT=20
HOURLY_REDDIT_LIMIT=3
